# ============================================
# Sadhana APPSC Telegram Automation - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit your .env file to version control!

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Supergroup ID (starts with -100...)
# To find: add @raw_data_bot to your group, it will reply with the chat ID
TELEGRAM_GROUP_ID=-100xxxxxxxxxx

# ============================================
# Optional: Google Sheets Integration (Cloud Spreadsheet)
# ============================================
# If defined, the bot connects to your online Google Sheet instead of local Excel files.
# To obtain: Paste google_apps_script.js in Extensions > Apps Script in Google Sheets,
# deploy as Web App (access: Anyone), and copy the deployment URL here.
# If left empty or commented out, the bot automatically uses local config.xlsx & questions.xlsx.
GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/AKfycb.../exec
